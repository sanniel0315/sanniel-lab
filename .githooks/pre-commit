#!/bin/sh
# 公開 repo 的守門員。
#
# 這是 public repo：commit 進來的東西一旦 push 就永遠留在 git 歷史裡，
# 就算之後刪掉也撤不回 —— 伺服器端與網頁存檔仍可能保有副本。
# 因此把關必須在 commit 之前。
#
# 擋兩件事：
#   1. 疑似個資的檔名
#   2. 疑似個資的內容（身分證字號、居留證號、手機、信用卡、護照）
#
# token 外洩可以撤銷重發；身分證字號無法撤銷。
#
# 安裝：git config core.hooksPath .githooks

fail=0

# --- 1. 檔名 ---------------------------------------------------------------
sensitive=$(git diff --cached --name-only --diff-filter=ACM |
    grep -E '身分證|成績單|在職證明|勞保|所得|離職證明|護照|戶籍|\.p12$|\.pfx$|\.pem$|id_rsa')

if [ -n "$sensitive" ]; then
    echo "✗ 以下檔案的檔名疑似個資，不該進公開 repo："
    echo "$sensitive" | sed 's/^/    /'
    fail=1
fi

# --- 2. 內容 ---------------------------------------------------------------
# 掃暫存區的實際內容，不是工作目錄 —— 兩者可能不同。
# 信用卡樣式限定首位為 3-6（Visa 4、MasterCard 5、AmEx 3、Discover 6）。
# ORCID iD 的形狀與信用卡號完全相同但一律 0 開頭，這樣就不會誤判。
#
# 先前是用「該行含 orcid 就跳過」，但排版工具把號碼與 URL 拆到不同行之後
# 那個判斷就失效了 —— 靠上下文的過濾在格式變動時會悄悄失去保護或悄悄誤擋。
# 改為以號碼本身的特徵判斷，與排版無關。
piifile=$(mktemp)
rm -f "$piifile"

git diff --cached --name-only --diff-filter=ACM |
    grep -E '\.(html|css|md|txt|json|ya?ml|js)$' |
while IFS= read -r f; do
    hits=$(git show ":$f" | grep -nE \
        -e '\b[A-Z][12][0-9]{8}\b' \
        -e '\b[A-Z][ABCD][0-9]{8}\b' \
        -e '\b09[0-9]{2}[- ]?[0-9]{3}[- ]?[0-9]{3}\b' \
        -e '\b[3-6][0-9]{3}[- ][0-9]{4}[- ][0-9]{4}[- ][0-9]{4}\b' \
        -e '護照號碼[[:space:]]*[:：]?[[:space:]]*[0-9]{8,9}')
    if [ -n "$hits" ]; then
        echo "✗ $f 疑似含個資："
        echo "$hits" | sed 's/^/    /'
        touch "$piifile"
    fi
done

if [ -e "$piifile" ]; then
    fail=1
    echo "  個資無法撤銷。確認是誤判再用 --no-verify。"
fi
rm -f "$piifile"

if [ $fail -ne 0 ]; then
    echo ""
    echo "commit 已中止。"
    exit 1
fi

exit 0
